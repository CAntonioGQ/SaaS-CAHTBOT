# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/empleadoia"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:redispassword@localhost:6379"

# ─── Auth (JWT) ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
AUTH_SECRET="change-me-to-a-random-64-char-string-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── Encryption ───────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting WhatsApp tokens at rest
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-bytes-base64-encoded"

# ─── OpenRouter (AI) ──────────────────────────────────────────────────────────
# Get key at https://openrouter.ai
# NEVER commit real key to git
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Model IDs (OpenRouter)
MODEL_FREE="tencent/hy3-preview:free"
MODEL_STARTER="deepseek/deepseek-chat-v3-0324"
MODEL_FALLBACK="deepseek/deepseek-chat-v3-0324"

# ─── WhatsApp Meta Cloud API ──────────────────────────────────────────────────
# Set up at https://developers.facebook.com
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""           # Used for HMAC X-Hub-Signature-256 verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN="" # Any random string you choose for GET challenge

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_STARTER_PRICE_ID=""

# ─── Storage (S3 or Azure Blob) ───────────────────────────────────────────────
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@tudominio.com"
